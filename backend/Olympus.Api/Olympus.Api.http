@Olympus.Api_HostAddress = http://localhost:5110
@token = REPLACE_WITH_JWT
@socioId = REPLACE_WITH_SOCIO_GUID
@planId = 1
@productoId = 1
@cajaId = 1
@pagoId = REPLACE_WITH_PAGO_GUID

### List pending membership payments (admin or professor)
GET {{Olympus.Api_HostAddress}}/api/admin/pagos/pendientes
Authorization: Bearer {{token}}

### Validate a pending bank-transfer payment (admin or professor)
PUT {{Olympus.Api_HostAddress}}/api/admin/pagos/{{pagoId}}/validar
Authorization: Bearer {{token}}
Content-Length: 0

### List registered users and current roles (admin)
GET {{Olympus.Api_HostAddress}}/api/admin/usuarios/roles
Authorization: Bearer {{token}}

### Assign the professor role to a registered account (admin)
PUT {{Olympus.Api_HostAddress}}/api/admin/usuarios/{{socioId}}/rol
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": "Profesor"
}

### Access reader: returns the boolean false/true as JSON
GET {{Olympus.Api_HostAddress}}/api/socios/verificar-acceso/27000001
Accept: application/json

### Read the created forum post by ID
GET {{Olympus.Api_HostAddress}}/api/foro/1
Accept: application/json

### Get a daily pass by ID (admin or professor)
GET {{Olympus.Api_HostAddress}}/api/pases-diarios/1
Authorization: Bearer {{token}}

### Open current shift (admin)
POST {{Olympus.Api_HostAddress}}/api/caja/abrir
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "montoInicial": 50000
}

### View current shift and live movement summary (admin)
GET {{Olympus.Api_HostAddress}}/api/caja/actual
Authorization: Bearer {{token}}

### Close current shift (admin)
POST {{Olympus.Api_HostAddress}}/api/caja/cerrar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "observaciones": "Arqueo de cierre"
}

### Closed shift report (admin)
GET {{Olympus.Api_HostAddress}}/api/caja/historial?desde=2026-10-01&hasta=2026-10-31
Authorization: Bearer {{token}}

### View sales, membership collections, and daily passes from a shift (admin)
GET {{Olympus.Api_HostAddress}}/api/caja/{{cajaId}}/detalle
Authorization: Bearer {{token}}

### Assign a complimentary membership to an existing member (admin)
POST {{Olympus.Api_HostAddress}}/api/admin/membresias/asignar
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuarioId": "{{socioId}}",
  "planMembresiaId": {{planId}},
  "tipoOtorgamiento": "Bonificada"
}

### Register a new member and assign a complimentary plan (admin)
POST {{Olympus.Api_HostAddress}}/api/admin/usuarios/crear-con-membresia
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Ejemplo",
  "dni": "30123457",
  "email": "ana.ejemplo@example.com",
  "password": "GymPass!2026",
  "planMembresiaId": {{planId}},
  "tipoOtorgamiento": "Bonificada"
}

### Product catalog (admin or professor)
GET {{Olympus.Api_HostAddress}}/api/productos
Authorization: Bearer {{token}}

### Create a product (admin)
POST {{Olympus.Api_HostAddress}}/api/productos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Agua",
  "stockActual": 20,
  "stockMinimo": 5,
  "precio": 1500,
  "codigo": "AGUA-001"
}

### Adjust stock (admin)
PUT {{Olympus.Api_HostAddress}}/api/productos/{{productoId}}/stock
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "stockActual": 25
}

### Sell products (admin or professor; requires an open shift)
POST {{Olympus.Api_HostAddress}}/api/productos/ventas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "metodoPago": "Efectivo",
  "items": [
    { "productoId": {{productoId}}, "cantidad": 2 }
  ]
}

### Register a cash membership payment (admin or professor)
POST {{Olympus.Api_HostAddress}}/api/pagos/efectivo
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "usuarioId": "{{socioId}}",
  "planMembresiaId": {{planId}},
  "metodoPago": "Efectivo"
}

### Register a daily pass (admin or professor)
POST {{Olympus.Api_HostAddress}}/api/pases-diarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombreCompleto": "Persona Visitante",
  "dni": "30123456",
  "metodoPago": "Efectivo"
}

### Create a forum post with an optional local image (admin)
POST {{Olympus.Api_HostAddress}}/api/foro/posts
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=OlympusBoundary

--OlympusBoundary
Content-Disposition: form-data; name="Titulo"

Aviso del gimnasio
--OlympusBoundary
Content-Disposition: form-data; name="Contenido"

Publicación de prueba.
--OlympusBoundary
Content-Disposition: form-data; name="Imagen"; filename="aviso.png"
Content-Type: image/png

< C:\path\to\aviso.png
--OlympusBoundary--
